@model quanlycoffe.Models.NhaCungCap
@{ ViewBag.Title = "Sửa Đối Tác"; }

<div class="panel panel-default" style="max-width: 700px; margin: 20px auto;">
    <div class="panel-heading" style="background-color: #f39c12; color: white;">
        <h3 class="panel-title" style="font-weight: bold;">📝 CẬP NHẬT THÔNG TIN ĐỐI TÁC</h3>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.HiddenFor(model => model.MANCC)

                <div class="form-group">
                    <label class="control-label col-md-3">Tên Công Ty:</label>
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.TenCongTy, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-3">Người Liên Hệ:</label>
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.NguoiLienHe, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-3">Địa Chỉ:</label>
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.DiaChi, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-3">Điện Thoại:</label>
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.DienThoai, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-3">Số Fax:</label>
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.Fax, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-3">Email:</label>
                    <div class="col-md-9">
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-3 col-md-9">
                        <button type="submit" class="btn btn-warning">💾 Cập Nhật</button>
                        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>