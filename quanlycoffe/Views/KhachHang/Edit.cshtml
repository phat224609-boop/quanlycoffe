@model quanlycoffe.Models.KhachHang
@{
    ViewBag.Title = "Chỉnh Sửa Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default" style="max-width: 600px; margin: 20px auto; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <div class="panel-heading" style="background-color: #0277bd; color: white; padding: 12px 20px;">
        <h3 class="panel-title" style="font-weight: bold; margin: 0;"><i class="fa fa-edit"></i> CẬP NHẬT THÔNG TIN KHÁCH HÀNG</h3>
    </div>
    <div class="panel-body" style="padding: 20px;">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" style="font-weight: bold;">
                <i class="fa fa-exclamation-triangle"></i> @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Edit", "KhachHang", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.MaKH)

            <div class="form-group">
                <label>Mã Khách Hàng (Không được sửa):</label>
                @Html.TextBoxFor(m => m.MaKH, new { @class = "form-control", @readonly = "readonly", @style = "background-color: #eee; font-weight: bold;" })
            </div>

            <div class="form-group">
                <label>Tên Khách Hàng <span style="color:red;">*</span>:</label>
                @Html.TextBoxFor(m => m.TenKH, new { @class = "form-control", @required = "required", @placeholder = "Nhập họ và tên..." })
            </div>

            <div class="form-group">
                <label>Số Điện Thoại:</label>
                @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", @placeholder = "Nhập số điện thoại..." })
            </div>

            <div class="form-group">
                <label>Địa Chỉ:</label>
                @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", @placeholder = "Nhập địa chỉ..." })
            </div>
            <div class="form-group">
                <label>Điểm Tích Lũy (Đổi thử để test lên hạng):</label>
                @Html.TextBoxFor(m => m.DiemTichLuy, new { @class = "form-control", @type = "number" })
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Khu Vực:</label>
                        @Html.DropDownList("MaKV", null, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Nhóm Khách:</label>
                        @Html.DropDownList("MaNhomKH", null, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Hạng Thẻ:</label>
                        @Html.DropDownList("MaHang", null, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <hr />
            <div style="text-align: right;">
                <a href="@Url.Action("Index")" class="btn btn-default">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary" style="font-weight: bold;">
                    <i class="fa fa-save"></i> LƯU THAY ĐỔI
                </button>
            </div>
        }
    </div>
</div>