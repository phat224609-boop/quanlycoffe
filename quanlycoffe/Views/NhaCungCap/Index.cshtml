@model IEnumerable<quanlycoffe.Models.NhaCungCap>
@{ ViewBag.Title = "Quản Lý Đối Tác"; }

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel panel-default" style="margin: 20px auto; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <div class="panel-heading" style="background-color: #3e2723; color: white; display: flex; justify-content: space-between; align-items: center; padding: 12px 20px;">
        <h3 class="panel-title" style="font-weight: bold;">🤝 DANH SÁCH ĐỐI TÁC / NHÀ CUNG CẤP</h3>
        <a href="@Url.Action("Create")" class="btn btn-success btn-sm" style="font-weight: bold;">➕ Thêm Đối Tác Mới</a>
    </div>
    <div class="panel-body">
        <table class="table table-bordered table-hover table-striped">
            <thead>
                <tr style="background-color: #efebe9; color: #4e342e;">
                    <th style="text-align: center; width: 70px;">Mã</th>
                    <th>Tên Nhà Cung Cấp / Công Ty</th>
                    <th>Người Liên Hệ</th>
                    <th>Địa Chỉ</th>
                    <th>Điện Thoại</th>
                    <th>Email</th>
                    <th style="text-align: center; width: 120px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center; font-weight: bold;">@item.MANCC</td>
                        <td style="font-weight: bold; color: #2c3e50;">@item.TenCongTy</td>
                        <td>@item.NguoiLienHe</td>
                        <td>@item.DiaChi</td>
                        <td style="color: #27ae60; font-weight: bold;">@item.DienThoai</td>
                        <td>@item.Email</td>
                        <td style="text-align: center;">
                            <a href="@Url.Action("Edit", new { id = item.MANCC })" class="btn btn-xs btn-warning">Sửa</a>
                            <a href="@Url.Action("Delete", new { id = item.MANCC })" class="btn btn-xs btn-danger" onclick="return confirm('Xóa nhà cung cấp này?')">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>