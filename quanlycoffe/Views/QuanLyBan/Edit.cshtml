@model quanlycoffe.Models.plp_Ban
@{
    ViewBag.Title = "Sửa thông tin bàn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-warning" style="margin-top:20px;">
    <div class="panel-heading"><h3 class="panel-title">CẬP NHẬT THÔNG TIN BÀN</h3></div>
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.MaBan)

            <div class="form-horizontal">
                <div class="form-group">
                    <label class="col-md-2 control-label">Tên Bàn:</label>
                    <div class="col-md-10">@Html.EditorFor(model => model.TenBan, new { htmlAttributes = new { @class = "form-control" } })</div>
                </div>

                <div class="form-group">
                    <label class="col-md-2 control-label">Khu Vực:</label>
                    <div class="col-md-10">@Html.DropDownList("MaKhuVuc", null, htmlAttributes: new { @class = "form-control" })</div>
                </div>

                <div class="form-group">
                    <label class="col-md-2 control-label">Số Ghế:</label>
                    <div class="col-md-10">@Html.EditorFor(model => model.SoGhe, new { htmlAttributes = new { @class = "form-control" } })</div>
                </div>

                <div class="form-group">
                    <label class="col-md-2 control-label">Trạng Thái:</label>
                    <div class="col-md-10">
                        <select name="TrangThai" class="form-control">
                            <option value="0" @(Model.TrangThai == 0 ? "selected" : "")>Trống</option>
                            <option value="1" @(Model.TrangThai == 1 ? "selected" : "")>Có khách</option>
                            <option value="2" @(Model.TrangThai == 2 ? "selected" : "")>Đặt trước</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        <a href="@Url.Action("Index")" class="btn btn-default">Quay lại</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>