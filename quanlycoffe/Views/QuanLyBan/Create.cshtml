@model quanlycoffe.Models.plp_Ban

@{
    ViewBag.Title = "Thêm Bàn Mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top: 20px;">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-success">
            <div class="panel-heading"><h3 class="panel-title">TẠO BÀN MỚI</h3></div>
            <div class="panel-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="control-label col-md-3">Tên Bàn:</label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.TenBan, new { htmlAttributes = new { @class = "form-control", @required = "required", @placeholder = "VD: Bàn 01, VIP 2..." } })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Khu Vực:</label>
                            <div class="col-md-9">
                                @Html.DropDownList("MaKhuVuc", null, htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Số Ghế:</label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.SoGhe, new { htmlAttributes = new { @class = "form-control", @type = "number", @min = "1", @Value = "4" } })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu Dữ Liệu</button>
                                <a href="@Url.Action("Index")" class="btn btn-default">Hủy bỏ</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>