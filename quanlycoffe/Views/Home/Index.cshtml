@{
    ViewBag.Title = "Trang Chủ";
}

<div class="text-center">
    <div style="margin-bottom: 20px;">
        <h1 style="color: #3e2723; font-weight: 900; font-size: 36px; margin-top: 0;">
            PRO COFFEE SYSTEM
        </h1>
        <p style="font-size: 16px; color: #795548;">Nền tảng quản lý vận hành chuyên nghiệp</p>
    </div>

    <div style="margin-bottom: 30px;">
        <img src="https://img.freepik.com/free-photo/fresh-coffee-steaming-cup-close-up-generative-ai_188544-8923.jpg"
             alt="Coffee Banner"
             style="width: 100%; max-width: 850px; /* Giảm nhẹ để lộ phần dưới */
                    height: auto;
                    border-radius: 20px;
                    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
                    border: 4px solid #fff;" />
    </div>

    <div class="row">
        <div class="col-md-4">
            <div style="padding: 20px; background: #efebe9; border-radius: 15px; border: 1px solid #d7ccc8;">
                <h4 style="font-weight:bold; color: #3e2723; margin:0;">⚡ SIÊU TỐC</h4>
                <p style="margin:5px 0 0 0; font-size: 12px;">Order nhanh chóng</p>
            </div>
        </div>
        <div class="col-md-4">
            <div style="padding: 20px; background: #efebe9; border-radius: 15px; border: 1px solid #d7ccc8;">
                <h4 style="font-weight:bold; color: #3e2723; margin:0;">📊 CHÍNH XÁC</h4>
                <p style="margin:5px 0 0 0; font-size: 12px;">Báo cáo chi tiết</p>
            </div>
        </div>
        <div class="col-md-4">
            <div style="padding: 20px; background: #efebe9; border-radius: 15px; border: 1px solid #d7ccc8;">
                <h4 style="font-weight:bold; color: #3e2723; margin:0;">🛡️ BẢO MẬT</h4>
                <p style="margin:5px 0 0 0; font-size: 12px;">An toàn dữ liệu</p>
            </div>
        </div>
    </div>
</div>