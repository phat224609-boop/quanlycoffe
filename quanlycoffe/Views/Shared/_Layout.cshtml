<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản Lý Cafe</title>

    @* Giữ lại file CSS của hệ thống *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* CSS ĐỘC QUYỀN CHO HEADER: Bất chấp mọi phiên bản Bootstrap */
        .pro-header {
            background-color: #3e2723; /* Màu nâu cafe */
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: space-between; /* Đẩy logo sang trái, menu sang phải */
            padding: 0 40px;
            position: fixed; /* Ghim chặt lên đầu trang */
            top: 0;
            left: 0;
            right: 0;
            z-index: 9999;
            box-shadow: 0 3px 10px rgba(0,0,0,0.3);
        }

            .pro-header a {
                color: white;
                text-decoration: none;
                font-size: 15px;
                padding: 10px 15px;
                border-radius: 5px;
                font-weight: 500;
                transition: all 0.2s ease-in-out;
                margin-left: 5px;
            }

                .pro-header a:hover {
                    background-color: #5d4037;
                    text-decoration: none;
                    color: #f39c12;
                }

            /* Nổi bật Logo */
            .pro-header .pro-logo {
                font-size: 22px !important;
                font-weight: bold;
                color: #f39c12 !important;
                padding: 0;
                background: transparent !important;
            }

        /* Nút Đăng nhập & Đăng xuất nổi bật */
        .btn-login {
            background-color: #27ae60;
            border: 1px solid #2ecc71;
        }

            .btn-login:hover {
                background-color: #2ecc71 !important;
                color: white !important;
            }

        .btn-logout {
            background-color: #c0392b;
        }

            .btn-logout:hover {
                background-color: #e74c3c !important;
                color: white !important;
            }

        /* Đẩy nội dung web xuống để không bị header che mất */
        body {
            padding-top: 90px;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

    @* --- THANH HEADER ĐÃ ĐƯỢC LÀM LẠI --- *@
    <div class="pro-header">
        <div>
            <a href="@Url.Action("Index", "Home")" class="pro-logo">☕ COFFEE MANAGER</a>
        </div>

        <div style="display: flex; align-items: center;">
            @* NẾU ĐÃ ĐĂNG NHẬP: Hiện menu quản lý và tên tài khoản *@
            @if (Session["UserID"] != null)
            {
                @* 1. Nhóm Bán hàng & Marketing *@
            <a href="@Url.Action("Index", "BanHang")" style="color: #e74c3c; font-weight: bold;">
                <i class="fa fa-shopping-cart"></i> Bán Hàng (POS)   </a>
            <a href="@Url.Action("Index", "KhachHang")"> <i class="fa fa-users"></i> Khách hàng </a>
                <a href="#" style="color: #bdc3c7;" title="Đang phát triển">Khuyến mãi</a>

                @* 2. Nhóm Quản lý Dữ liệu (Đã code xong) *@
                <a href="@Url.Action("Index", "SanPham")">Hàng hóa</a>
                if (Session["Quyen"] != null && Session["Quyen"].ToString() == "Admin")
                {
                    <a href="@Url.Action("Index", "NhaCungCap")">Đối tác</a>
                    <a href="@Url.Action("Index", "HeThong")">Hệ thống</a>
                    <a href="@Url.Action("DSTaiKhoan", "HeThong")"><i class="fa fa-key"></i> Quản lý tài khoản</a>
                }
                    @* 3. Nhóm Vận hành & Thống kê *@
                   
                    <a href="#" style="color: #bdc3c7;" title="Đang phát triển">Báo cáo</a>



                    <span style="color: #bdc3c7; margin: 0 15px 0 20px;">|</span>
                    <span style="color: white; margin-right: 15px;">
                        Chào, <b style="color: #f39c12;">@Session["LoginName"]</b>
                    </span>

                    <a href="@Url.Action("Logout", "Account")" class="btn-logout">Đăng xuất</a>
                }
                @* NẾU CHƯA ĐĂNG NHẬP: Chỉ hiện nút Đăng nhập *@
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn-login">Đăng nhập</a>
                }
            </div>
    </div>

    @* --- PHẦN NỘI DUNG WEB BÊN DƯỚI --- *@
    <div class="container body-content">
        @RenderBody()
        <hr style="border-top: 1px solid #ccc; margin-top: 40px;" />
        <footer>
            <p style="color: #555; text-align: center;">
                &copy; @DateTime.Now.Year - Nền tảng quản lý vận hành chuyên nghiệp Pro Coffee System - Leader: <b>@(Session["LoginName"] ?? "Nguyễn Tấn Phát")</b>
            </p>
        </footer>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>